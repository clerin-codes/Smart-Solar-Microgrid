{
  "MongoDbSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "SmartSolarMicrogrid"
  },
  "JwtSettings": {
    "SecretKey": "replace-with-at-least-32-bytes-from-user-secrets-or-server-configuration",
    "Issuer": "SmartSolarMicrogrid.Api",
    "Audience": "SmartSolarMicrogrid.Clients",
    "ExpiryMinutes": 120
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173"]
  },
  "SeedData": {
    "Enabled": false,
    "BackofficePassword": "",
    "GridOperatorPassword": "",
    "ProsumerPassword": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
