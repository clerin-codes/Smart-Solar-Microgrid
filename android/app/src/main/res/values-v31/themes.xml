<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same theme as values/themes.xml, plus the Android 12+ system splash screen branding. -->
    <style name="Theme.SunChain" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">#F8FAFD</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
